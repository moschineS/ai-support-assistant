# Active LLM provider: "ollama" (offline/local demo) or "openai" (cloud path)
PROVIDER=ollama

# --- Ollama (offline demo path) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- OpenAI (cloud path) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Database (docker-compose exposes pgvector on host port 5433) ---
DATABASE_URL=postgresql://assist:assist@localhost:5433/assist

# --- Retrieval / grounding ---
RETRIEVAL_K=6
GROUNDING_MIN_SIMILARITY=0.30