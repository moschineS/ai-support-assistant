# --- OpenAI API (Azure OpenAI in the cloud target; identical wire format) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Database (docker-compose exposes pgvector on host port 5433) ---
DATABASE_URL=postgresql://assist:assist@localhost:5433/assist
# No-Docker fallback (FTS5 + in-process cosine; same API semantics):
# DATABASE_URL=sqlite:///assist.db

# --- Retrieval / grounding ---
RETRIEVAL_K=6
GROUNDING_MIN_SIMILARITY=0.30